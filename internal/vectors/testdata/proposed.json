 "P.4": [
  {
   "instance": "\"ab--cd\"",
   "bytes": "2261622d2d636422",
   "hostname": "accept",
   "idn-hostname": "422",
   "why": "RFC 1123 allows hyphens anywhere inside a label; as an IDN label it is R-LDH (`--` in positions 3–4) without the `xn--` prefix, so not an A-label"
  },
  {
   "instance": "\"·\"",
   "bytes": "22c2b722",
   "hostname": "422",
   "idn-hostname": "422",
   "why": "U+00B7 is CONTEXTO: RFC 5892 A.3 needs `l` before and after it; not LDH for `hostname`"
  },
  {
   "instance": "\"XN--BCHER-KVA\"",
   "bytes": "22584e2d2d42434845522d4b564122",
   "hostname": "accept",
   "idn-hostname": "accept",
   "why": "an uppercase A-label: LDH for `hostname`; for `idn-hostname`, `xn--` matched case-insensitively, decodes to `bücher` and re-encodes to the same label ignoring case"
  },
  {
   "instance": "\"l·l\"",
   "bytes": "226cc2b76c22",
   "hostname": "422",
   "idn-hostname": "accept",
   "why": "control: U+00B7 between two `l`s satisfies its CONTEXTO rule"
  },
  {
   "instance": "\"xn--bcher-kva\"",
   "bytes": "22786e2d2d62636865722d6b766122",
   "hostname": "accept",
   "idn-hostname": "accept",
   "why": "control: the lowercase A-label"
  }
 ],
