{
  "name": "patchlog-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var AUTH:disabled",
    "dev:grants": "wrangler dev --port 8788 --var \"OPERATOR_JWKS:$(node bench/auth-smoke.mjs --jwks)\"",
    "deploy": "wrangler deploy",
    "smoke": "node bench/smoke.mjs",
    "bench": "node bench/load.mjs",
    "build": "worker-build --release crates/worker",
    "workerd": "mkdir -p .workerd-data && workerd serve bench/workerd.capnp --directory-path disk=$PWD/.workerd-data"
  },
  "devDependencies": {
    "undici": "^7.30.1",
    "wrangler": "4.156.2"
  }
}
